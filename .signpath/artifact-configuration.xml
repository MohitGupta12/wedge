<?xml version="1.0" encoding="utf-8"?>
<!-- Paste this into SignPath as the project's default artifact configuration.
     GitHub Actions uploads the installer inside a ZIP; SignPath signs the .exe in it. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="Wedge Setup *.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
